# Copy to .env (docker compose reads it). All values shown are defaults.
KAFKA_BOOTSTRAP=localhost:9092
TOPIC=transactions
DLQ_TOPIC=transactions.dlq
TOPIC_PARTITIONS=6
CONSUMER_GROUP=sentinel-scorers
REDIS_URL=redis://localhost:6379/0
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
DECISIONS_TABLE=sentinel_decisions
DDB_WCU=25
DDB_RCU=25
SCORER_URL=http://localhost:8080
MODEL_PATH=models/model.json
META_PATH=models/model_meta.json
BATCH_SIZE=100
POLL_TIMEOUT_S=0.5
MAX_RETRIES=3
RETRY_BASE_DELAY_S=0.1
DEDUPE_TTL_S=86400
DDB_WORKERS=16
APPROVE_SAMPLE_RATE=1.0
XGB_NTHREAD=1
BATCHER_MAX_SIZE=64
BATCHER_MAX_WAIT_MS=0
SCORER_WORKERS=2
LOG_LEVEL=INFO
RESULTS_DIR=results
